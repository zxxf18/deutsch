syntax = "v1"

import "base.api"

info(
    title: "Invite Code API"
    desc: "邀请码管理"
    author: "zx"
    date: "2025-10-13 16:39:11"
    version: "1.0"
)

type InviteCode {
    Id string `path:"id" json:"id"`
    Code string `path:"code" json:"code"`
    UsedBy string `path:"usedBy" json:"usedBy,omitempty"`
    ExpiresAt int64 `path:"expiresAt" json:"expiresAt"`
    CreatedBy string `path:"createdBy" json:"createdBy,omitempty"`
    IsEnabled bool `path:"isEnabled" json:"is_enabled"`
    CreatedAt int64 `path:"createdAt" json:"createdAt"`
}

type GetInviteCodeRequest {
    ID string `path:"id" json:"id"`
}

type GetInviteCodeResponse {
    Base
    Data {
        InviteCode
    } `json:"data"`
}

type DeleteInviteCodeRequest {
    ID string `path:"id" json:"id"`
}

type DeleteInviteCodeResponse {
    Base
}

type EnableInviteCodeRequest {
    ID        string `path:"id" json:"id"`
    IsEnabled bool   `json:"is_enabled"`
}

type EnableInviteCodeResponse {
    Base
}

type ListInviteCodeRequest {
    Filter
    AvailableOnly bool `form:"availableOnly,optional"` // 仅查看可用的邀请码（未使用、未过期、已启用）
}

type ListInviteCodeResponse {
    Base
    Data {
        Filter
        Total int64  `json:"total"`
        Items []InviteCode `path:"items" json:"items"`
    } `json:"data"`
}

type GenerateInviteCodeRequest {
    Count int `json:"count,optional,default=1"` // 生成邀请码数量
}

type GenerateInviteCodeResponse {
    Base
    Data {
        Items []InviteCode `path:"items" json:"items"`
    } `json:"data"`
}

@server (
	prefix:  /api/v1/invitecode
	timeout: 3s
	group:   invitecode
	jwt:     JWTAuth
)
service Deutsch {
	// 无auth: 验证
	@handler ValidateHandler
	get /validate/:id returns (Base)
}

@server (
	prefix:     /api/v1/invitecode
	timeout:    3s
	group:      invitecode
	jwt:        JWTAuth
	middleware: JWTMiddleware,AdminMiddleware
)
service Deutsch {
	@handler GenerateHandler
	post /generate (GenerateInviteCodeRequest) returns (GenerateInviteCodeResponse)

	@handler GetInviteCodeHandler
	get /:id returns (GetInviteCodeResponse)

	@handler ListHandler
	get /list (ListInviteCodeRequest) returns (ListInviteCodeResponse)

	@handler EnableHandler
	patch /:id/enable (EnableInviteCodeRequest) returns (EnableInviteCodeResponse)

	@handler DeleteHandler
	delete /:id returns (DeleteInviteCodeResponse)
}
