syntax = "v1"

info (
	title:   "API Base"
	desc:    "Base types"
	author:  "zx"
	date:    "2025-10-13 16:39:11"
	version: "1.0"
)

type Base {
	Code int    `json:"code"`
	Msg  string `json:"msg"`
}

// Filter 分页参数，从 query 解析（GET ?pageNo=1&pageSize=10），不使用 path 避免解析错误
type Filter {
	PageNo   int `form:"pageNo,optional,default=1" json:"pageNo" validate:"omitempty,gte=1"`
	PageSize int `form:"pageSize,optional,default=10" json:"pageSize" validate:"omitempty,gte=1,lte=100"`
}

// 通用响应
type Response {
	Base
	Data interface{} `path:"data" json:"data"`
}

// 通用分页响应
type ListResponse {
	Data []interface{} `path:"data" json:"data"`
	Filter
	Total int64 `path:"total" json:"total"`
}

