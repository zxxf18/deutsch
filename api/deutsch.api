syntax = "v1"

import "base.api"

service Deutsch {
	@handler ping
	get /ping
}

import "auth.api"

@server (
	prefix:  /api/v1/auth
	timeout: 3s
	group:   auth
)
service Deutsch {
	@handler RegisterHandler
	post /register (RegisterRequest) returns (RegisterResponse)

	@handler LoginHandler
	post /login (LoginRequest) returns (LoginResponse)
}

@server (
	prefix:  /api/v1/auth
	timeout: 3s
	group:   auth
	jwt:     JWTAuth
)
service Deutsch {
	@handler LogoutHandler
	post /logout returns (LogoutResponse)

	@handler JWTRefreshHandler
	post /jwt/refresh returns (JWTRefreshResponse)

	@handler GenerateInviteHandler
	post /invite/generate (GenerateInviteRequest) returns (GenerateInviteResponse)
}

