syntax = "v1"

import "base.api"

service Deutsch {
	@handler ping
	get /ping
}

import "auth.api"

@server (
	prefix:  /api/v1/auth
	timeout: 3s
	group:   auth
)
service Deutsch {
	@handler RegisterHandler
	post /auth/register (RegisterRequest) returns (RegisterResponse)

	@handler LoginHandler
	post /auth/login (LoginRequest) returns (LoginResponse)
}

@server (
	prefix:     /api/v1/auth
	timeout:    3s
	group:      auth
	jwt:        JWTAuth
	middleware: JWTMiddleware
)
service Deutsch {
	@handler LogoutHandler
	post /logout returns (LogoutResponse)

	@handler GenerateInviteHandler
	post /invite/generate (GenerateInviteRequest) returns (GenerateInviteResponse)
}

