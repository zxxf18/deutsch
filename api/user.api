syntax = "v1"

import "base.api"

info(
    title: "User API"
    desc: "用户管理"
    author: "zx"
    date: "2025-10-13 16:39:11"
    version: "1.0"
)

// User 用户
type User {
    ID          string `path:"id" json:"id,omitempty"`
    Username    string `path:"username" json:"username,omitempty" validate:"omitempty,alphanum,min=6,max=50"`
    Email       string `path:"email" json:"email,omitempty" validate:"omitempty,email"`
    Password    string `path:"password" json:"password,omitempty"` // 仅登录/注册使用
    Phone       string `path:"phone" json:"phone,omitempty" validate:"omitempty,len=11,numeric"`
    Role        string `path:"role" json:"role,omitempty" validate:"omitempty,oneof=user admin guest"`
    Nickname    string `path:"nickname" json:"nickname,omitempty" validate:"omitempty,max=50"`
    IsEnabled   bool   `path:"isEnabled" json:"is_enabled,omitempty"`
    Description string `path:"description" json:"description,omitempty" validate:"omitempty,max=500"`
    InviteCode  string `path:"inviteCode" json:"invite_code,omitempty" validate:"omitempty,alphanum,min=4,max=32"`
    CreatedAt   int64  `path:"createdAt" json:"createdAt,omitempty"`
    UpdatedAt   int64  `path:"updatedAt" json:"updatedAt,omitempty"`
}

type GetUserRequest {
    ID string `path:"id"`
}

type GetUserResponse {
    Base
    Data {
        User
    } `json:"data"`
}

// UpdateUserRequest 更新个人资料（不嵌入 User，避免 path:"id" 解析错误）
type UpdateUserRequest {
    Nickname    string `json:"nickname,optional" validate:"omitempty,max=50"`
    Description string `json:"description,optional" validate:"omitempty,max=500"`
}

type UpdateUserResponse {
    Base
    Data {
        User
    } `json:"data"`
}

type DeleteUserRequest {
    ID string `path:"id" json:"id"`
}

type DeleteUserResponse {
    Base
}

type EnableUserRequest {
    ID        string `path:"id" json:"id"`
    IsEnabled bool   `json:"is_enabled"`
}

type EnableUserResponse {
    Base
}

type ListUserRequest {
    Filter
}

type ListUserResponse {
    Base
    Data {
        Filter
        Total int64  `json:"total"`
        Items []User `path:"items" json:"items"`
    } `json:"data"`
}

@server (
	prefix:     /api/v1/user
	timeout:    3s
	group:      user
	jwt:        JWTAuth
	middleware: JWTMiddleware
)
service Deutsch {
	@handler GetUserHandler
	get /:id (GetUserRequest) returns (GetUserResponse)

	@handler UpdateUserHandler
	patch /profile (UpdateUserRequest) returns (UpdateUserResponse)
}

@server (
	prefix:     /api/v1/user
	timeout:    3s
	group:      user
	jwt:        JWTAuth
	middleware: JWTMiddleware,AdminMiddleware
)
service Deutsch {
	@handler ListUserHandler
	get /list (Filter) returns (ListUserResponse)

	@handler DeleteUserHandler
	delete /:id (DeleteUserRequest) returns (DeleteUserResponse)

	@handler EnableUserHandler
	patch /:id/enable (EnableUserRequest) returns (EnableUserResponse)
}
