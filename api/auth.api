syntax = "v1"

import "base.api"
import "user.api"

info(
    title: "Authentication API"
    desc: "Auth(JWT)相关"
    author: "zx"
    date: "2025-10-13 16:39:11"
    version: "1.0"
)

type JWT {
    JWTToken string `json:"jwt_token"`
    Expires int64 `json:"expires"`
    MaxRefresh int64 `json:"max_refresh"`
}

type AuthResponse {
    Base
    Data {
        User
        JWT
    } `json:"data"`
}

type RegisterRequest {
    User
}

type RegisterResponse {
    AuthResponse
}

type LoginRequest {
    User
}

type LoginResponse {
    AuthResponse
}

type LogoutResponse {
    Base
}

type JWTRefreshResponse {
    AuthResponse
}



