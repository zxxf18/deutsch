syntax = "v1"

import "base.api"

info(
    title: "User Authentication API"
    desc: "Handles registration, login, logout for test prep users. Uses JWT for sessions."
    author: "zx"
    date: "2025-10-13 16:39:11"
    version: "1.0"
)

type RegisterRequest {
    Phone string `json:"phone"`
    Password string `json:"password,min=8"`
    Username string `json:"username,min=3,max=50"`
    Nickname string `json:"nickname,optional"`
    InviteCode string `json:"invite_code"` // 必填邀请码
}

type RegisterResponse {
    Base
    Data {
        UserId int64 `json:"user_id"`
        JWTToken string `json:"jwt_token"`
    } `json:"data"`
}

type LoginRequest {
    Username string `json:"username"`
    Password string `json:"password"`
}

type LoginResponse {
    Base
    Data {
        UserId string `json:"user_id"`
        JWTToken string `json:"jwt_token"`
        ExpiresIn int64 `json:"expires_in,default=3600"`
        Role string `json:"role"` // 返回角色
    } `json:"data"`
}

type LogoutResponse {
    Base
}

type GenerateInviteRequest {
    Count int32 `json:"count,optional,default=1"` // 生成邀请码数量
}

type GenerateInviteResponse {
    Base
    Data {
        Codes []string `json:"codes"`
    } `json:"data"`
}


