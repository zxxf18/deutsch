syntax = "v1"

import "base.api"
import "user.api"

info(
    title: "Authentication API"
    desc: "Auth(JWT)相关"
    author: "zx"
    date: "2025-10-13 16:39:11"
    version: "1.0"
)

type Jwt {
    JwtToken string `json:"jwt_token"`
    Expires int64 `json:"expires"`
    MaxRefresh int64 `json:"max_refresh"`
}

type AuthResponse {
    Base
    Data {
        User
        Jwt
    } `json:"data"`
}

// LoginRequest 登录请求（不嵌入 User，避免 path:"id" 解析错误）
type LoginRequest {
    Email    string `json:"email,optional"`
    Phone    string `json:"phone,optional"`
    Password string `json:"password"`
}

// RegisterRequest 注册请求
type RegisterRequest {
    Email      string `json:"email"`
    Password   string `json:"password"`
    InviteCode string `json:"invite_code"`
    Username   string `json:"username,optional"`
    Nickname   string `json:"nickname,optional"`
    Phone      string `json:"phone,optional"`
}

type RegisterResponse {
    AuthResponse
}

type LoginResponse {
    AuthResponse
}

type LogoutResponse {
    Base
}

type JwtRefreshResponse {
    AuthResponse
}

@server (
	prefix:  /api/v1/auth
	timeout: 3s
	group:   auth
)
service Deutsch {
	@handler RegisterHandler
	post /register (RegisterRequest) returns (RegisterResponse)

	@handler LoginHandler
	post /login (LoginRequest) returns (LoginResponse)
}

@server (
	prefix:  /api/v1/auth
	timeout: 3s
	group:   auth
	jwt:     JWTAuth
)
service Deutsch {
	@handler LogoutHandler
	post /logout returns (LogoutResponse)

	@handler JwtRefreshHandler
	post /jwt/refresh returns (JwtRefreshResponse)
}



